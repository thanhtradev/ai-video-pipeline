    "@remotion/renderer": "4.0.534",
    "diff": "9.0.0",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "dbmate": "2.37.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
