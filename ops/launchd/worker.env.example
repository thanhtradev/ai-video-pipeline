# Copy to ~/.config/aivideo/worker.env on the worker Mac (chmod 600). No secrets here:
# passwords and keys are read from the Keychain by ops/launchd/run-worker.sh.
# Must match the PostgreSQL login: worker id mac-mini-m4 <-> role aivideo_worker_mac_mini_m4.
WORKER_ID=mac-mini-m4
# Single active worker (D-034): consume every stream, highest priority first.
WORKER_STREAMS=q:render,q:heavy,q:light
DB_HOST=192.168.1.102
DB_NAME=aivideo
DB_USER=aivideo_worker_mac_mini_m4
REDIS_HOST=192.168.1.112
REDIS_USER=aivideo-worker-mac-mini-m4
REDIS_DB=1
WORK_ROOT=/Users/aivideo/work
# Tailscale address of this Mac (macmini = 100.71.214.125, docs/infrastructure.md S-09).
API_HOST=100.71.214.125
API_PORT=8787
LEASE_SECONDS=60
HEARTBEAT_SECONDS=20
LOG_LEVEL=info
# Claude Code CLI (D-042). launchd's PATH lacks ~/.local/bin, so give the absolute path
# (`which claude`). Optional: CLAUDE_MODEL; never a fallback model.
CLAUDE_BIN=/Users/aivideo/.local/bin/claude
CLAUDE_TIMEOUT_SECONDS=600
# How long a job waits after a Claude Code usage limit before it is retried.
CLAUDE_BLOCK_SECONDS=3600
# ITERA TTS (D-040). The API key is the Keychain item aivideo-itera-api-key, never this file.
ITERA_BASE_URL=https://api.genmax.io
ITERA_POLL_MS=2000
ITERA_TASK_TIMEOUT_SECONDS=300
# How long a tts job waits after a key, credit, quota, or configuration problem.
ITERA_BLOCK_SECONDS=3600
FFPROBE_BIN=/opt/homebrew/bin/ffprobe
# Preview rendering (2c): ffmpeg normalises loudness; the shared music library has catalog.json
# (D-047). Without MUSIC_LIBRARY_DIR previews are rendered without music.
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
MUSIC_LIBRARY_DIR=/Users/aivideo/MediaLibrary/music
