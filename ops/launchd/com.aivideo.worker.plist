<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the pipeline worker (P-009). Install with the sed command in ops/README.md §4,
  which replaces /Users/aivideo with the real home and repo paths and prepends the Node binary
  directory to PATH (launchd does not load the shell profile, so nvm's node is otherwise missing).
  A LaunchAgent runs in the user's login session, which it needs to read the login Keychain;
  after a reboot it starts only once the user logs in at the console (R-13).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aivideo.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aivideo/ai-video-pipeline/ops/launchd/run-worker.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- Checkout run-worker.sh starts the worker from (default ~/ai-video-pipeline). -->
    <key>AIVIDEO_REPO</key>
    <string>/Users/aivideo/ai-video-pipeline</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- SIGTERM lets the worker finish its current job; the lease watchdog covers longer jobs. -->
  <key>ExitTimeOut</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/aivideo/Library/Logs/aivideo-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/aivideo/Library/Logs/aivideo-worker.log</string>
</dict>
</plist>
