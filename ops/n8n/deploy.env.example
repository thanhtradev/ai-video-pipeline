# Copy to ops/n8n/deploy.env (gitignored; no secrets belong here). The values fill the
# placeholders in n8n/workflows/*.json when ops/n8n/deploy-workflows.sh stages the files.
# Telegram approval chat id (REPLACE_WITH_APPROVAL_CHAT_ID); a group id is negative.
APPROVAL_CHAT_ID=
# Worker API as seen from LXC 104, Tailscale address of the Mac mini (REPLACE_WITH_WORKER_URL).
WORKER_URL=http://100.71.214.125:8787
# Defaults from docs/infrastructure.md; uncomment to override.
# PVE_HOST=pve
# LXC_ID=104
# N8N_CONTAINER=n8n
# N8N_DATA_DIR=/mnt/data/docker-utils/n8n_data
# N8N_HEALTH_URL=http://127.0.0.1:5678/healthz
