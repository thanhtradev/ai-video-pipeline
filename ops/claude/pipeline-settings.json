{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "default",
    "allow": [],
    "deny": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(git push:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(security:*)",
      "Bash(psql:*)",
      "Bash(redis-cli:*)",
      "Bash(launchctl:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/aivideo/**)",
      "Read(~/Library/Keychains/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
