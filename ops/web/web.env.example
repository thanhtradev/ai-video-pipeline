# Copy to ops/web/web.env (gitignored by .env rules below) and fill in. Never commit the password.
# Role aivideo_web_lxc104 only: it can call web_* functions and nothing else.
DATABASE_URL=postgres://aivideo_web_lxc104:<password>@192.168.1.102:5432/aivideo
# The address in the browser, https://<host> with no path. A write from any other origin is refused.
WEB_PUBLIC_ORIGIN=https://<lxc-utils MagicDNS name>
