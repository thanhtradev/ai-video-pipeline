# Copy to ~/aivideo/config/worker.env on the Linux worker (chmod 600; D-065, D-075). No secrets
# here: passwords and keys are files in ~/aivideo/config/secrets/ (ops/systemd/run-worker.sh).
# Must match the PostgreSQL login: worker id hp-400-g7 <-> role aivideo_worker_hp_400_g7.
WORKER_ID=hp-400-g7
# Videos are pinned to the worker that starts them (D-074), so every worker serves every stream.
WORKER_STREAMS=q:render,q:heavy,q:light
DB_HOST=192.168.1.102
DB_NAME=aivideo
DB_USER=aivideo_worker_hp_400_g7
REDIS_HOST=192.168.1.112
REDIS_USER=aivideo-worker-hp-400-g7
REDIS_DB=1
WORK_ROOT=/home/aivideo/aivideo/work
# Tailscale address of this machine ([UNKNOWN] until it joins the tailnet: `tailscale ip -4`).
API_HOST=REPLACE_WITH_TAILSCALE_IP
API_PORT=8787
# The same API as n8n reaches it (D-074).
WORKER_API_URL=http://REPLACE_WITH_TAILSCALE_IP:8787
LEASE_SECONDS=60
HEARTBEAT_SECONDS=20
LOG_LEVEL=info
# Claude Code CLI (D-042): absolute path from `which claude`. Never a fallback model.
CLAUDE_BIN=/home/aivideo/.local/bin/claude
CLAUDE_TIMEOUT_SECONDS=600
CLAUDE_BLOCK_SECONDS=3600
ITERA_BASE_URL=https://api.genmax.io
ITERA_POLL_MS=2000
ITERA_TASK_TIMEOUT_SECONDS=300
ITERA_BLOCK_SECONDS=3600
# Archive (D-063): the same Google Drive remote, configured on this machine with `rclone config`.
ARCHIVE_RCLONE_REMOTE="aivideo-drive:AI Video Archive"
RCLONE_BIN=/usr/bin/rclone
FFPROBE_BIN=/usr/bin/ffprobe
FFMPEG_BIN=/usr/bin/ffmpeg
MUSIC_LIBRARY_DIR=/home/aivideo/aivideo/media/music
# whisper.cpp built from source (ops/linux-worker.md §3).
WHISPER_BIN=/home/aivideo/aivideo/models/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/home/aivideo/aivideo/models/whisper/ggml-large-v3-turbo.bin
# CPU-only machine (i5-10500, 6 cores / 12 threads, no GPU; D-075): software GL, fewer threads.
# Benchmark one episode and adjust (docs/infrastructure.md).
REMOTION_GL=swangle
RENDER_CONCURRENCY=6
WHISPER_THREADS=6
