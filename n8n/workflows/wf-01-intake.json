{
  "id": "aivideoWf01Intak",
  "name": "WF-01 Intake",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "authentication": "basicAuth",
        "formTitle": "AI Video brief",
        "formDescription": "One 9:16 Short (under 60 s). Write the topic and notes in Vietnamese.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Topic",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "Vì sao bầu trời có màu xanh?"
            },
            {
              "fieldLabel": "Duration (seconds)",
              "fieldType": "number",
              "requiredField": true,
              "placeholder": "15-59"
            },
            { "fieldLabel": "Audience", "placeholder": "học sinh cấp 2" },
            { "fieldLabel": "Tone", "placeholder": "vui vẻ, dễ hiểu" },
            { "fieldLabel": "Notes", "fieldType": "textarea" }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "appendAttribution": false,
          "path": "aivideo-brief",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Brief received. The script approval request arrives on Telegram."
            }
          }
        }
      },
      "id": "6f1d6a10-0000-4000-8000-000000000101",
      "name": "Brief form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 0],
      "credentials": { "httpBasicAuth": { "id": "aivideoFormAuth1", "name": "aivideo-form-auth" } },
      "webhookId": "6f1d6a10-0000-4000-8000-0000000001ff"
    },
    {
      "parameters": {
        "jsCode": "// Map the form fields to the brief stored in Postgres. Validation lives in SQL (brief_normalize),\n// so an invalid brief fails the execution and WF-99 reports it.\nconst form = $input.first().json;\nconst text = (label) => {\n  const value = form[label];\n  return typeof value === 'string' && value.trim() !== '' ? value.trim() : undefined;\n};\nconst brief = {\n  topic: text('Topic'),\n  duration_seconds: Number(form['Duration (seconds)']),\n  audience: text('Audience'),\n  tone: text('Tone'),\n  notes: text('Notes'),\n};\nreturn [{ json: { submissionId: `n8n-form-${$execution.id}`, brief: JSON.stringify(brief) } }];"
      },
      "id": "6f1d6a10-0000-4000-8000-000000000102",
      "name": "Build brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT video_id::text AS video_id, version_id::text AS version_id, job_id::text AS job_id, created FROM video_submit($1, $2::jsonb);",
        "options": { "queryReplacement": "={{ [$json.submissionId, $json.brief] }}" }
      },
      "id": "6f1d6a10-0000-4000-8000-000000000103",
      "name": "Create video",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [440, 0],
      "credentials": { "postgres": { "id": "aivideoPgCred001", "name": "aivideo-postgres" } }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst shortId = String(row.video_id).slice(0, 8);\nconst verb = row.created ? 'New video submitted' : 'Duplicate form submission ignored';\nreturn [{ json: { text: `[AI Video] ${verb}\\nVideo ${shortId} v1: scripting` } }];"
      },
      "id": "6f1d6a10-0000-4000-8000-000000000104",
      "name": "Build status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_APPROVAL_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "6f1d6a10-0000-4000-8000-000000000105",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 0],
      "credentials": { "telegramApi": { "id": "aivideoTgCred001", "name": "aivideo-telegram" } }
    }
  ],
  "connections": {
    "Brief form": { "main": [[{ "node": "Build brief", "type": "main", "index": 0 }]] },
    "Build brief": { "main": [[{ "node": "Create video", "type": "main", "index": 0 }]] },
    "Create video": { "main": [[{ "node": "Build status", "type": "main", "index": 0 }]] },
    "Build status": { "main": [[{ "node": "Notify Telegram", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "aivideoWf99Error",
    "saveDataSuccessExecution": "none"
  },
  "pinData": {}
}
