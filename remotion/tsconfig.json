{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2023", "dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src", "test"],
  "exclude": [
    "src/rig",
    "src/kits",
    "src/characters",
    "src/episodes",
    "src/channels.ts",
    "src/ChannelsRoot.tsx",
    "test/catalog.test.ts"
  ]
}
